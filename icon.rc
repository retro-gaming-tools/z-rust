  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "retro-gaming-tools"
      VALUE "FileDescription", "Z - Rust"
      VALUE "ProductName", "Z - Rust"
      VALUE "FileVersion", "0.62-beta"
      VALUE "ProductVersion", "0.62-beta"
      VALUE "InternalName", "z-rust"
      VALUE "OriginalFilename", "z-rust.exe"
      VALUE "LegalCopyright", "Port: see LICENSE. Z belongs to its rights holders; no game data is included."
      VALUE "Comments", "https://github.com/retro-gaming-tools/z-rust"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
